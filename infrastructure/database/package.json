{
  "name": "@escritorio/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx --conditions=source src/cli.ts migrate",
    "rollback": "tsx --conditions=source src/cli.ts rollback",
    "seed": "tsx --conditions=source src/cli.ts seed",
    "status": "tsx --conditions=source src/cli.ts status"
  },
  "dependencies": {
    "@escritorio/shared": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
