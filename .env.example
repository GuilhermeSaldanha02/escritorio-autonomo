# Copie para .env e ajuste. O .env NUNCA é versionado.
# Todos os valores abaixo são locais e de desenvolvimento: nenhum é segredo real
# nem credencial de serviço externo. Não há chave de IA — AI_MODE=mock no M1.

NODE_ENV=development
LOG_LEVEL=info

# Único modo implementado no M1. local/api chegam com o AI Gateway (M3).
AI_MODE=mock

API_HOST=127.0.0.1
API_PORT=3000

# --- Docker Compose (PostgreSQL + pgvector) ---
POSTGRES_USER=escritorio
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=escritorio
POSTGRES_PORT=5432

# --- Docker Compose (Redis) ---
REDIS_PORT=6379

# --- Aplicação ---
DATABASE_URL=postgres://escritorio:troque-esta-senha-local@localhost:5432/escritorio
REDIS_URL=redis://localhost:6379/0
QUEUE_PREFIX=escritorio

# Opcional: caminho alternativo para a constituição (padrão: config/constitution.yaml)
# CONSTITUTION_PATH=

# Prazo para API e Worker encerrarem graciosamente (ms). Jobs em andamento terminam dentro dele.
SHUTDOWN_TIMEOUT_MS=20000

# --- Testes de integração (banco e índice Redis separados) ---
TEST_DATABASE_URL=postgres://escritorio:troque-esta-senha-local@localhost:5432/escritorio_test
TEST_REDIS_URL=redis://localhost:6379/1
